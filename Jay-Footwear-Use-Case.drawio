        <mxCell id="title" value="USE CASE DIAGRAM — JAY FOOTWEAR SALES &amp; INVENTORY MANAGEMENT SYSTEM" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="1000" height="35" as="geometry"/></mxCell>
